{
  "name": "motix-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:chrome": "vite build && vite build --config vite.content.config.ts && bun scripts/package.mjs chrome",
    "build:firefox": "vite build && vite build --config vite.content.config.ts && bun scripts/package.mjs firefox",
    "typecheck": "tsc --noEmit",
    "generate:logos": "bun scripts/generate-logos.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  }
}
